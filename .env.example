# Contact form (/api/contact): sent through Microsoft Graph by the app registration
# "Prisma House website contact form" (Mail.Send on one mailbox only, via Exchange RBAC)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
CONTACT_SENDER_MAILBOX=gianmarco@prisma-house.com
CONTACT_FROM_EMAIL=info@prisma-house.com
CONTACT_TO_EMAIL=info@prisma-house.com

# Calendly embed on the contact page
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link/intro-call

# Canonical site URL used for SEO metadata, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://prisma-house.com
